<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav>
        <a href="/">Home</a>
        <a href="/all">All Expenses</a>
        <a href="/top3">Top 3 Expenses</a>
        <a href="/search">Search Expenses</a>
        <a href="/expensive">Filter by Amount</a>
        <a href="/stats">Stats</a>
    </nav>
    <h1>Expense Tracker</h1>
    <br>
    <h2>Filter Expenses by Amount</h2>
    <br>
    <form action="/expensive" method="get">
        <label for="amount">Search by Amount:</label>
        <input type="number" id="amount" name="amount" placeholder="Enter minimum amount">
        <button type="submit">Filter</button>
    </form>
    <br>
    <h3>Expenses:</h3>
    <table style="width: 350px; border-collapse: collapse;">
        <tr style="background-color: #f2f2f2;">
            <th>Name</th>
            <th>Amount</th>
            <th>Category</th>
        </tr>
        <%if (allExpenses.length === 0) { %>
            <tr>
                <td colspan="3">No expenses found.</td>
            </tr>
        <% }  else { %>
            <% allExpenses.forEach(expense => { %>
                <tr style="background-color: <%= colorCodes[expense.category] %>;">
                    <td><%= expense.name %></td>
                    <td><%= expense.amount %> Ft</td>
                    <td><%= expense.category %></td>
                </tr>
            <% }); %>
        <% } %>
    </table>
</body>
</html>