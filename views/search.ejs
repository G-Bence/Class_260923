<%- include('partials/header') %>
    <br>
    <h2>Search Expenses</h2>
    <br>
    <form action="/search" method="get">
        <label for="searchedName">Search by Name:</label>
        <input type="text" id="searchedName" name="searchedName" placeholder="Enter expense name">
        <button type="submit">Search</button>
    </form>
    <br>
    <h3>Expenses:</h3>
    <table style="width: 350px; border-collapse: collapse;">
        <tr style="background-color: #f2f2f2;">
            <th>Name</th>
            <th>Amount</th>
            <th>Category</th>
        </tr>
        <%if (allExpenses.length === 0) { %>
            <tr>
                <td colspan="3">No expenses found.</td>
            </tr>
        <% }  else { %>
            <% allExpenses.forEach(expense => { %>
                <tr style="background-color: <%= colorCodes[expense.category] %>;">
                    <td><%= expense.name %></td>
                    <td><%= expense.amount %> Ft</td>
                    <td><%= expense.category %></td>
                </tr>
            <% }); %>
        <% } %>
    </table>
<%- include('partials/footer') %>